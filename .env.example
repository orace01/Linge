# Copy to .env.local (never committed). On Vercel: Project → Settings → Environment Variables.

# --- CJdropshipping ---
CJ_API_KEY=
# Your own IOSS number (EU import VAT). Leave empty to use CJ's IOSS: CJ then charges the VAT on each order.
CJ_IOSS_NUMBER=

# --- Stock (Vercel Blob) ---
# Added automatically on Vercel when the Blob store is connected; needed in GitHub Actions secrets.
BLOB_READ_WRITE_TOKEN=

# --- Orders ---
# off (default): nothing can be ordered · test: simulated payment, nothing charged or shipped
# live: real payments (needs a payment provider) and real CJ orders paid from the CJ balance
ORDER_MODE=
# Encrypts the stored orders (customers' names and addresses). Long random text; never change it afterwards.
ORDERS_SECRET=
# Password of the /admin/commandes page (at least 12 characters).
ADMIN_SECRET=
# In test mode, also create a CJ *sandbox* order (nothing charged, nothing shipped) for each test order.
CJ_TEST_ORDERS=

# --- E-mails (optional, https://resend.com) ---
RESEND_API_KEY=
# e.g. "Lucéa <commandes@your-domain.fr>" (the domain must be verified at Resend)
ORDER_EMAIL_FROM=
# Where you are told about each order
ORDER_NOTIFY_EMAIL=
